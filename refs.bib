@article{ghorbianLargeLanguageModels2026,
  title = {Large {{Language Models}} for {{Code Generation}}: {{A Survey}}},
  shorttitle = {Large {{Language Models}} for {{Code Generation}}},
  author = {Ghorbian, Mohsen and {Ghobaei-Arani}, Mostafa and Shakarami, Ali},
  year = 2026,
  month = apr,
  journal = {Computer Standards \& Interfaces},
  pages = {104165},
  issn = {09205489},
  doi = {10.1016/j.csi.2026.104165},
  urldate = {2026-04-14},
  abstract = {As one of the most advanced achievements of artificial intelligence and a new paradigm in a field long served by other techniques such as Non-Large Language Models approaches, Large language models (LLMs) have brought about a significant transformation in the Code Generation (CoGe) process. With the ability to process vast amounts of text data and comprehend the intricacies of programming languages, these models can generate, complete, and optimize executable code tailored to specific needs, leading to increased productivity and reduced complexity in software development. However, the use of this technology is accompanied by challenges, including the generation of unsafe codes, failure to comply with the best programming standards, and the need to manage extensive computational resources. This review article examines the applications, challenges, and achievements of LLMs in CoGe. It analyzes the impact of this technology on enhancing the precision and productivity of programming. The primary objective of this article is to assess the effects of these models on the CoGe process from multiple perspectives. Through a systematic meta-inference of the selected studies, the results indicate a strong consensus and clear evidence that LLMs substantially enhance the efficiency of code generation, improve code security, and facilitate the learning of complex concepts. Through a systematic meta-inference framework---a novel approach for synthesizing heterogeneous evidence where formal meta-analysis is infeasible---the results indicate a strong consensus and clear evidence that LLMs substantially enhance the efficiency of code generation, improve code security, and facilitate the learning of complex concepts. Accordingly, the findings suggest that LLMs have significant potential in enhancing the quality and efficiency of CoGe processes and can be regarded as a scientifically grounded and methodologically practical instrument for advancing productivity and strengthening standards in software development.},
  langid = {english},
  file = {/Users/ericjanz/Zotero/storage/UES7F6HW/Ghorbian et al. - 2026 - Large Language Models for Code Generation A Survey.pdf}
}

@article{jiangSurveyLargeLanguage2026,
  title = {A {{Survey}} on {{Large Language Models}} for {{Code Generation}}},
  author = {Jiang, Juyong and Wang, Fan and Shen, Jiasi and Kim, Sungju and Kim, Sunghun},
  year = 2026,
  month = jan,
  journal = {ACM Transactions on Software Engineering and Methodology},
  volume = {35},
  number = {2},
  pages = {1--72},
  issn = {1049-331X, 1557-7392},
  doi = {10.1145/3747588},
  urldate = {2026-05-09},
  abstract = {Large Language Models (LLMs) have garnered remarkable advancements across diverse code-related tasks, known as Code LLMs, particularly in code generation that generates source code with LLM from natural language descriptions. This burgeoning field has captured significant interest from both academic researchers and industry professionals due to its practical significance in software development, e.g.,               GitHub Copilot               . Despite the active exploration of LLMs for a variety of code tasks, either from the perspective of Natural Language Processing (NLP) or Software Engineering (SE) or both, there is a noticeable absence of a comprehensive and up-to-date literature review dedicated to LLM for code generation. In this survey, we aim to bridge this gap by providing a systematic literature review that serves as a valuable reference for researchers investigating the cutting-edge progress in LLMs for code generation. We introduce a taxonomy to categorize and discuss the recent developments in LLMs for code generation, covering aspects such as data curation, latest advances, performance evaluation, ethical implications, environmental impact, and real-world applications. In addition, we present a historical overview of the evolution of LLMs for code generation and provide a quantitative and qualitative comparative analysis of experimental results of code LLMs, sourced from their original papers to ensure a fair comparison on the HumanEval, MBPP, and BigCodeBench benchmarks, across various levels of difficulty and types of programming tasks, to highlight the progressive enhancements in LLM capabilities for code generation. We identify critical challenges and promising opportunities regarding the gap between academia and practical development. Furthermore, we have established a dedicated resource GitHub page (               https://github.com/juyongjiang/CodeLLMSurvey               ) to continuously document and disseminate the most recent advances in the field.},
  langid = {english},
  file = {/Users/ericjanz/Zotero/storage/QHMDFI5G/Jiang et al. - 2026 - A Survey on Large Language Models for Code Generation.pdf}
}

@article{liuEmpiricalStudyLowcode2026a,
  title = {An Empirical Study on Low-Code Programming Using Traditional vs Large Language Model Support},
